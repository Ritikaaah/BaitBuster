{
  "manifest_version": 3,
  "name": "BaitBuster",
  "version": "1.0.0",
  "description": "A thoughtful second opinion before you click.",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "action": {
    "default_title": "BaitBuster",
    "default_popup": "popup.html"
  }
}
